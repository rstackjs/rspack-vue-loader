{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "sourceMap": false,
    "target": "es2015",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "allowJs": false,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "removeComments": false,
    "skipLibCheck": true,
    "lib": ["es2022", "DOM"],
    "types": ["rstack/test/globals"],
    "paths": {
      "rspack-vue-loader": ["../src/index.ts"],
      "src": ["../src"]
    }
  }
}
