{
  "name": "rspack-vue-loader",
  "version": "17.6.2",
  "license": "MIT",
  "author": "Evan You",
  "repository": "rstackjs/rspack-vue-loader",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "build-example": "rm -rf example/dist && webpack --config example/webpack.config.js --env.prod",
    "build-example-ssr": "rm -rf example/dist-ssr && webpack --config example/webpack.config.js --env.prod --env.ssr && node example/ssr.js",
    "check": "rs check",
    "dev": "rs lib -w",
    "dev-example": "node example/devServer.js --config example/webpack.config.js --inline --hot",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "prepublishOnly": "pnpm run build",
    "pretest": "rs lib",
    "pretest:match-resource": "rs lib",
    "test": "NODE_OPTIONS=--openssl-legacy-provider rs test",
    "test:match-resource": "INLINE_MATCH_RESOURCE=true NODE_OPTIONS=--openssl-legacy-provider rs test"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@rspack/lite-tapable": "^1.1.0",
    "chalk": "^4.1.0"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.7.7",
    "@babel/preset-env": "^7.11.5",
    "@intlify/vue-i18n-loader": "^3.0.0",
    "@rspack/core": "^2.1.8",
    "@swc/helpers": "^0.5.23",
    "@types/cssesc": "^3.0.2",
    "@types/estree": "^0.0.45",
    "@types/jsdom": "^16.2.13",
    "@types/mini-css-extract-plugin": "^0.9.1",
    "@types/webpack-merge": "^4.1.5",
    "babel-loader": "^8.1.0",
    "cache-loader": "^4.1.0",
    "css-loader": "^4.3.0",
    "cssesc": "^3.0.0",
    "file-loader": "^6.1.0",
    "html-webpack-plugin": "^4.5.0",
    "html-webpack-plugin-v5": "npm:html-webpack-plugin@^5.6.8",
    "jsdom": "^16.4.0",
    "markdown-loader": "^6.0.0",
    "memfs": "^3.1.2",
    "mini-css-extract-plugin": "^1.6.2",
    "normalize-newline": "^3.0.0",
    "null-loader": "^4.0.1",
    "postcss-loader": "^4.0.4",
    "pug": "^2.0.0",
    "pug-plain-loader": "^1.0.0",
    "rstack": "^0.7.2",
    "source-map": "^0.6.1",
    "style-loader": "^2.0.0",
    "stylus": "^0.54.7",
    "stylus-loader": "^4.1.1",
    "sugarss": "^3.0.1",
    "ts-loader": "^8.0.6",
    "ts-loader-v9": "npm:ts-loader@^9.2.4",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.0",
    "vue": "^3.4.3",
    "vue-i18n": "^9.1.7",
    "webpack": "^5.79.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3",
    "webpack-merge": "^5.1.4"
  }
}
