{
  "name": "rspack-vue-loader",
  "version": "17.7.0",
  "license": "MIT",
  "author": "Evan You",
  "repository": "rstackjs/rspack-vue-loader",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "bump": "pnpm version -m \"release: v%s\"",
    "build-example": "rspack build --config example/rspack.config.js --env prod",
    "build-example-ssr": "rspack build --config example/rspack.config.js --env prod --env ssr && node example/ssr.js",
    "check": "rs check",
    "dev": "tsc --watch",
    "dev-example": "rspack dev --config example/rspack.config.js",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "prepublishOnly": "tsc",
    "pretest": "tsc",
    "pretest:match-resource": "tsc",
    "test": "rs test",
    "test:match-resource": "INLINE_MATCH_RESOURCE=true rs test"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@rspack/lite-tapable": "^1.1.0",
    "chalk": "^4.1.0"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@intlify/vue-i18n-loader": "^3.0.0",
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "@rspack/dev-server": "^2.2.1",
    "@swc/helpers": "^0.5.23",
    "@types/cssesc": "^3.0.2",
    "@types/estree": "^0.0.45",
    "@types/jsdom": "^16.2.13",
    "css-loader": "^7.1.5",
    "cssesc": "^3.0.0",
    "jsdom": "^16.4.0",
    "markdown-loader": "^6.0.0",
    "memfs": "^3.1.2",
    "null-loader": "^4.0.1",
    "pug": "^2.0.0",
    "pug-plain-loader": "^1.0.0",
    "rspack-merge": "^1.0.1",
    "rstack": "^0.7.2",
    "source-map": "^0.6.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.4.3",
    "vue-i18n": "^9.1.7"
  }
}
